node_modules/
.wrangler/
.dev.vars

# Everything under public/ is build output — site/scripts/build.sh says so
# outright. It used to be committed, all 91k lines of it, including 26 MB of
# CanvasKit wasm. `worker-rs`'s deploy script now builds it (bun run assets)
# rather than shipping whatever happened to be in the checkout.
public/engine/
public/index.html
public/main.js
public/mark.js
public/styles.css
public/architecture/
public/docs/
public/*.ttf
public/*.woff2
public/*.webp
public/*.png
public/*LICENSE.txt

# Generated by scripts/build-hub.sh (bun run build:hub) — the Flutter web
# build of the hub that the landing page embeds.
public/hub/

# Generated by scripts/build-portal.sh (bun run build:portal) — the signed-in
# hub web app served at /portal.
public/portal/

# Download cache for the vendored on-device model runtime, populated by the
# same script so a rebuild does not refetch it.
.cache/

{
  "name": "omi-web-moonshine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "start": "bun run src/server.ts",
    "build": "bun run src/server.ts",
    "build:client": "bun run scripts/build-client.ts",
    "build:static": "bun run build:client && bun run src/build-static.ts",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@tschk/moonshine": "file:../../../moonshine/packages/core",
    "@tschk/moonshine-adapter-conformance": "file:../../../moonshine/packages/adapter-conformance",
    "@tschk/moonshine-compiler": "file:../../../moonshine/packages/compiler",
    "@tschk/moonshine-deploy-bun": "file:../../../moonshine/packages/deploy-bun",
    "@tschk/moonshine-deploy-cloudflare": "file:../../../moonshine/packages/deploy-cloudflare",
    "@tschk/moonshine-framework": "file:../../../moonshine/packages/framework",
    "@tschk/moonshine-react": "file:../../../moonshine/packages/react",
    "@tschk/moonshine-router": "file:../../../moonshine/packages/router",
    "@tschk/moonshine-server": "file:../../../moonshine/packages/server",
    "@tschk/moonshine-shaders": "file:../../../moonshine/packages/shaders",
    "gsap": "^3.15.0",
    "lenis": "^1.3.25",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "7.0.2"
  }
}
